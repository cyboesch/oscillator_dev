Bootstrap: docker
From: ubuntu:22.04

%labels
    Maintainer cb7454@princeton.edu

%files
    requirements.txt /requirements.txt

%environment
    export VSCODE_INSTALL_DIR=/opt/VSCode-linux-x64
    export VSCODE_BINARY_URL="https://code.visualstudio.com/sha/download?build=stable&os=linux-x64"
    export USER=cb7454
    export GROUP=cb7454
    export PYTHONPATH=/workspace:/workspace/projects
    export PATH=$VSCODE_INSTALL_DIR/bin:$PATH
    export HOME=/home/$USER

%post
    # Create workspace directory (if needed)
    mkdir -p /workspace

    # Install Ubuntu dependencies
    apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y \
         build-essential \
         curl \
         python3-pip \
         libnss3 \
         libatk1.0-0 \
         libatk-bridge2.0-0 \
         gmsh \
         zsh \
         libgtk-3-0 \
         libx11-xcb1 \
         libxcomposite1 \
         libxcursor1 \
         libxdamage1 \
         libxrandr2 \
         libasound2 \
         libpangocairo-1.0-0 \
         libcups2 \
         libxss1 \
         libxshmfence1 \
         libgbm1 && \
         apt-get clean && rm -rf /var/lib/apt/lists/*

    # Install VSCode
    mkdir -p ${VSCODE_INSTALL_DIR}/data
    curl -L ${VSCODE_BINARY_URL} -o /tmp/vscode-linux-x64.tar.gz
    tar -zxvf /tmp/vscode-linux-x64.tar.gz --directory ${VSCODE_INSTALL_DIR} --strip-components=1
    rm /tmp/vscode-linux-x64.tar.gz

    # Create user and group to avoid permission issues
    groupadd -g 1000 ${USER}
    useradd -m -u 1000 -g ${USER} -s /usr/bin/zsh ${USER}
    chown -R ${USER}:${USER} /home/${USER}
    chown -R ${USER}:${USER} ${VSCODE_INSTALL_DIR}

    # Install fixuid
    curl -SsL https://github.com/boxboat/fixuid/releases/download/v0.6.0/fixuid-0.6.0-linux-amd64.tar.gz | \
         tar -C /usr/local/bin -xzf -
    chown root:root /usr/local/bin/fixuid
    chmod 4755 /usr/local/bin/fixuid
    mkdir -p /etc/fixuid
    echo -e "user: ${USER}\ngroup: ${USER}" > /etc/fixuid/config.yml

    # Fix permissions on the user's home directory
    chown -R ${USER}:${USER} /home/${USER}

    # Install Python dependencies from the copied requirements.txt file
    pip3 install -r /requirements.txt && rm -f /requirements.txt

%runscript
    exec /bin/bash
